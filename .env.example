# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# ID da aplicação (Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID do servidor para registrar os comandos instantaneamente (recomendado)
# Deixe vazio para registrar os comandos globalmente (pode levar até 1 hora)
GUILD_ID=

# Registra os comandos automaticamente ao iniciar o bot
AUTO_DEPLOY=true

# Caminho do banco de dados SQLite
DB_PATH=./data/bot.db
